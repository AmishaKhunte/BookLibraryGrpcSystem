* {
  box-sizing: border-box;
}

:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #e5eefb;
  background: #09111d;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  margin: 0;
  min-height: 100vh;
  background: linear-gradient(180deg, #09111d 0%, #0f1e2d 100%);
}

button,
input {
  font: inherit;
}

.container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 32px 20px 48px;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
  gap: 16px;
}

.eyebrow {
  margin: 0 0 8px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 12px;
  color: #8db8ff;
}

h1 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3rem);
}

h2 {
  margin-top: 0;
  margin-bottom: 12px;
}

.badge {
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(135, 206, 250, 0.12);
  border: 1px solid rgba(135, 206, 250, 0.3);
  color: #bfe1ff;
  font-size: 0.82rem;
}

.panel {
  background: rgba(15, 25, 38, 0.8);
  border: 1px solid rgba(153, 180, 255, 0.2);
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.14);
}

.concept-panel {
  margin-bottom: 20px;
}

.concept-panel ul {
  margin: 14px 0 0;
  padding-left: 18px;
  color: #d2e3ff;
}

.controls {
  margin-bottom: 20px;
}

label {
  display: block;
  margin-bottom: 10px;
  font-weight: 600;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
}

.buttons-row {
  margin-top: 12px;
}

input {
  flex: 1 1 180px;
  min-width: 0;
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(156, 172, 255, 0.25);
  color: #f2f7ff;
  padding: 12px 14px;
  border-radius: 10px;
}

button {
  background: linear-gradient(135deg, #4d8dff 0%, #7c63ff 100%);
  color: #fff;
  border: none;
  padding: 11px 16px;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 600;
  transition: transform 0.15s ease, opacity 0.2s ease;
}

button:hover:not(:disabled) {
  transform: translateY(-1px);
}

button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

button.secondary {
  background: rgba(110, 145, 255, 0.14);
  border: 1px solid rgba(146, 165, 255, 0.35);
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
}

.book-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 8px;
}

.book-list li {
  padding: 10px 12px;
  background: rgba(132, 158, 255, 0.07);
  border: 1px solid rgba(132, 158, 255, 0.12);
  border-radius: 10px;
}

pre {
  margin: 0;
  white-space: pre-wrap;
  background: rgba(5, 10, 18, 0.5);
  border: 1px solid rgba(147, 164, 255, 0.18);
  border-radius: 10px;
  padding: 14px;
  color: #dfeaff;
  overflow: auto;
}

.muted {
  color: #b3c4df;
}

.error {
  color: #ffd0d0;
  background: rgba(148, 32, 32, 0.2);
  border-color: rgba(255, 90, 90, 0.35);
  margin-bottom: 18px;
}

.info {
  margin-bottom: 18px;
  color: #d4ebff;
}
